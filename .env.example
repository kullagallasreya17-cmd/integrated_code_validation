# See backend/services/orchestrator-service/.env.example,
# backend/services/code-quality-service/.env.example, and
# frontend/.env.example for the per-service variables.
POSTGRES_DB=coding_validation
POSTGRES_USER=coding_validation
POSTGRES_PASSWORD=CodingValidation123!@
# Use the HTTPS frontend origin(s) in production. These defaults are for local development.
GATEWAY_CORS_ORIGINS=http://localhost:5174,http://127.0.0.1:5174,http://localhost:5173,http://127.0.0.1:5173
# Secure cookies are required on HTTPS deployments. Local HTTP development should leave this false.
AUTH_COOKIE_SECURE=false
# Enables the separate shared demo identity only for a private development environment.
LOCAL_DEMO_AUTH_ENABLED=false
# Optional. Set both values to provision the first Administrator at Gateway startup.
# Keep the password only in an untracked .env/secret manager; never commit it.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=System Administrator

# Ollama model used by the Repair and Report/Recommendation agents.
OLLAMA_MODEL=qwen2.5-coder:3b
OLLAMA_HOST_PORT=11434
OLLAMA_REQUEST_TIMEOUT_SECONDS=600
ORCH_REPAIR_CALL_TIMEOUT_SECONDS=660
ORCH_AI_REPORT_TIMEOUT_SECONDS=1250

# Internal URL used by the Bug & Resource Analysis agent in Docker Compose.
ORCH_BUG_RESOURCE_SERVICE_URL=http://bug-resource:8000
BUG_RESOURCE_PORT=8005
